{
  "name": "interactive-math-book",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace interactive-math-book-app",
    "build": "tsc -p tsconfig.tests.json && npm run build --workspace interactive-math-book-app",
    "preview": "npm run preview --workspace interactive-math-book-app",
    "test": "npm run test:model && npm run test:ui",
    "test:model": "playwright test --config=playwright.model.config.ts",
    "test:ui": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
